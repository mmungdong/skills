{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crwu.local/schema/audit-result/1.2.0",
  "title": "AuditResult",
  "description": "CRWU 审核意见送达规范 v1.6 §9 统一 AuditResult JSON 数据结构（机器可校验 Schema；语义重算规则见同目录 audit_delivery.py 与规范 §9.4；HTML 及监控统计均由同一对象派生）。",
  "type": "object",
  "required": [
    "schemaVersion",
    "auditTask",
    "phaseControl",
    "summary",
    "issues",
    "manualConfirmationItems",
    "auditBasis",
    "reviewComparison",
    "scope",
    "professionalTrail",
    "fileTrace",
    "renderPolicy",
    "aiScorecard",
    "selfAuditErrors"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\."
    },
    "auditTask": {
      "type": "object",
      "required": [
        "projectId",
        "reportVersion",
        "auditTime",
        "engineVersion",
        "profile"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "reportVersion": {
          "type": "string",
          "minLength": 1
        },
        "auditTime": {
          "type": "string",
          "minLength": 1
        },
        "engineVersion": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "object",
          "properties": {
            "objectType": {
              "type": "string"
            },
            "methods": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "scenario": {
              "type": "string"
            },
            "stage": {
              "type": "string"
            },
            "routeProfile": {
              "type": "object"
            }
          }
        }
      }
    },
    "phaseControl": {
      "type": "object",
      "required": [
        "phase1FrozenAt",
        "phase1Digest"
      ],
      "properties": {
        "phase1FrozenAt": {
          "type": "string",
          "minLength": 1
        },
        "phase1Digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewAccessedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase2CompletedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "审核总结事实源。renderer 从既有问题与人工确认明细生成三行行动摘要；narrative 原文完整保留并默认折叠，不新增业务事实。",
      "required": [
        "overallDecision",
        "narrative",
        "counts"
      ],
      "properties": {
        "overallDecision": {
          "enum": [
            "pass",
            "fail",
            "pending_confirmation"
          ]
        },
        "narrative": {
          "type": "string",
          "minLength": 1,
          "description": "完整 AI 审核说明；员工页面默认折叠展示，行动摘要从 issues[] 与 manualConfirmationItems[] 确定性派生。"
        },
        "counts": {
          "type": "object",
          "description": "首屏计数事实源；各值必须可由 issues[]、manualConfirmationItems[] 与 scope.notCheckedItems[] 重算。",
          "required": [
            "issuesTotal",
            "fail",
            "high",
            "medium",
            "low",
            "pendingConfirmation",
            "notChecked"
          ],
          "properties": {
            "issuesTotal": {
              "type": "integer",
              "minimum": 0
            },
            "fail": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "pendingConfirmation": {
              "type": "integer",
              "minimum": 0
            },
            "notChecked": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issueId",
          "title",
          "module",
          "locationSummary",
          "severity",
          "issueType",
          "decision",
          "problemDescription",
          "handlingRequirement",
          "ruleEvidence",
          "materialEvidence",
          "gapAnalysis",
          "recommendedEdits",
          "flowStatus",
          "confidence",
          "reviewComparison"
        ],
        "properties": {
          "issueId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "locationSummary": {
            "type": "string",
            "minLength": 1,
            "description": "员工定位问题的首要位置摘要；HTML 与 materialEvidence[] 的文件名、locator 共同组成醒目的问题位置面板。"
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "issueType": {
            "enum": [
              "rule_defect",
              "reasonableness_doubt",
              "unsupported_pending"
            ]
          },
          "decision": {
            "enum": [
              "fail",
              "pending_confirmation",
              "pass"
            ]
          },
          "problemDescription": {
            "type": "string",
            "minLength": 1,
            "maxLength": 420,
            "description": "员工首屏必读字段，写法见送达规范 §4.6（两段式）：第一段为首句结论（一句话说清问题是什么，≤60 字，以 。；！？ 收尾，不得含规则编号/知识库路径/内部代号）；其后另起一行为明细，共 2–4 行、每行 ≤80 字，写明差异是什么与去哪个文件、sheet、单元格、页码核对，明细须给出本次材料的可核对落点。规则条款与完整判定链放 gapAnalysis 与 ruleEvidence，不得写入本字段。"
          },
          "handlingRequirement": {
            "type": "string",
            "minLength": 1
          },
          "ruleEvidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ruleId",
                "authorityClass",
                "sourceType",
                "title",
                "version",
                "clause",
                "quote",
                "kbRelativePath",
                "exportedAt"
              ],
              "properties": {
                "ruleId": {
                  "type": "string",
                  "minLength": 1
                },
                "authorityClass": {
                  "enum": [
                    "external_formal",
                    "internal_auxiliary",
                    "experience_reference"
                  ]
                },
                "sourceType": {
                  "enum": [
                    "law",
                    "valuation_standard",
                    "valuation_method_rule",
                    "regulatory",
                    "association",
                    "internal_audit",
                    "crwu_kb",
                    "risk_case"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "clause": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "paraphrase": {
                  "type": "string"
                },
                "kbRelativePath": {
                  "type": "string",
                  "pattern": "^(?!/)(?![A-Za-z]:)(?!~)(?!file://)"
                },
                "exportedAt": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "materialEvidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "fileId",
                "displayName",
                "locator",
                "excerptOrValue",
                "evidenceRole"
              ],
              "properties": {
                "fileId": {
                  "type": "string",
                  "minLength": 1
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1
                },
                "section": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "locator": {
                  "description": "证据定位。材料侧：`<文件名>!<sheet>!<单元格或区域>`。非单元格证据（图片/页眉页脚/批注/形状/图表）另用受控写法：`<sheet>!图片#<序号>（锚点 <起始行>:<结束行>）`、`<sheet>!页眉`、`<sheet>!页脚`、`<sheet>!批注!<单元格>`、`<sheet>!图形#<序号>`、扫描件 `<文件名>#第<N>页`。该形态只能来自 raw 原件直读（工作版不含这些部件）；未核验的写「未核验」，严禁写「缺失/为空/未列示」。口径见 00-input-and-route-profile.md §Excel 与 11-html-delivery-spec.md §4.3。",
                  "type": "string",
                  "minLength": 1
                },
                "excerptOrValue": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceRole": {
                  "type": "string",
                  "minLength": 1
                },
                "contentHash": {
                  "type": "string"
                }
              }
            }
          },
          "gapAnalysis": {
            "type": "object",
            "required": [
              "ruleRequirement",
              "observedCondition",
              "difference",
              "finalJudgment"
            ],
            "properties": {
              "ruleRequirement": {
                "type": "string",
                "minLength": 1
              },
              "observedCondition": {
                "type": "string",
                "minLength": 1
              },
              "difference": {
                "type": "string",
                "minLength": 1
              },
              "finalJudgment": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "recommendedEdits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "fileId",
                "displayName",
                "locator",
                "action"
              ],
              "properties": {
                "fileId": {
                  "type": "string",
                  "minLength": 1
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "description": "证据定位。材料侧：`<文件名>!<sheet>!<单元格或区域>`。非单元格证据（图片/页眉页脚/批注/形状/图表）另用受控写法：`<sheet>!图片#<序号>（锚点 <起始行>:<结束行>）`、`<sheet>!页眉`、`<sheet>!页脚`、`<sheet>!批注!<单元格>`、`<sheet>!图形#<序号>`、扫描件 `<文件名>#第<N>页`。该形态只能来自 raw 原件直读（工作版不含这些部件）；未核验的写「未核验」，严禁写「缺失/为空/未列示」。口径见 00-input-and-route-profile.md §Excel 与 11-html-delivery-spec.md §4.3。",
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "flowStatus": {
            "enum": [
              "pending_response",
              "answered",
              "reviewed"
            ]
          },
          "confidence": {
            "type": "object",
            "required": [
              "level",
              "reason"
            ],
            "properties": {
              "level": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "reviewComparison": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_performed",
                  "performed"
                ]
              },
              "category": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  null
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "fail"
                },
                "issueType": {
                  "const": "rule_defect"
                }
              },
              "required": [
                "decision",
                "issueType"
              ]
            },
            "then": {
              "properties": {
                "ruleEvidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "manualConfirmationItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "itemId",
          "title",
          "locationSummary",
          "observation",
          "questionToConfirm",
          "evidence",
          "suggestedAction"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locationSummary": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "questionToConfirm": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          },
          "suggestedAction": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "auditBasis": {
      "type": "object",
      "required": [
        "rules",
        "ruleMap",
        "knowledgeBaseFiles"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ruleId",
              "authorityClass",
              "sourceType",
              "title",
              "version",
              "clause",
              "quote",
              "kbRelativePath",
              "exportedAt",
              "usageCount",
              "purposes",
              "usedByIssueIds"
            ],
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "authorityClass": {
                "enum": [
                  "external_formal",
                  "internal_auxiliary",
                  "experience_reference"
                ]
              },
              "sourceType": {
                "enum": [
                  "law",
                  "valuation_standard",
                  "valuation_method_rule",
                  "regulatory",
                  "association",
                  "internal_audit",
                  "crwu_kb",
                  "risk_case"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "clause": {
                "type": "string",
                "minLength": 1
              },
              "effectiveStatus": {
                "enum": [
                  "effective",
                  "expired",
                  "unknown",
                  "internal"
                ]
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "paraphrase": {
                "type": "string"
              },
              "kbRelativePath": {
                "type": "string",
                "pattern": "^(?!/)(?![A-Za-z]:)(?!~)(?!file://)"
              },
              "exportedAt": {
                "type": "string",
                "minLength": 1
              },
              "usageCount": {
                "type": "integer",
                "minimum": 0
              },
              "purposes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "usedByIssueIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sourceFingerprint": {
                "type": "string"
              }
            }
          }
        },
        "ruleMap": {
          "type": "object"
        },
        "knowledgeBaseFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "exportedAt"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!~)(?!file://)"
              },
              "exportedAt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "reviewComparison": {
      "type": "object",
      "required": [
        "status",
        "bands",
        "reviewerOnlyItems",
        "metrics"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_performed",
            "performed"
          ]
        },
        "hiddenRegionAccess": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "authorizedBy",
              "authorizedAt",
              "authorization",
              "scope",
              "notRead"
            ],
            "properties": {
              "authorizedBy": {
                "type": "string",
                "minLength": 1
              },
              "authorizedAt": {
                "type": "string",
                "minLength": 1
              },
              "authorization": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "notRead": {
                "type": "string"
              },
              "resultingIssueIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "reviewFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "order",
              "level",
              "displayName",
              "version"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "level": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "reviewItems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "itemId",
              "title",
              "module",
              "reviewLevel",
              "matchStatus",
              "linkedIssueIds",
              "reviewerEvidence",
              "inFileResolution",
              "handling"
            ],
            "properties": {
              "itemId": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "module": {
                "type": "string",
                "minLength": 1
              },
              "reviewLevel": {
                "type": "string",
                "minLength": 1
              },
              "matchStatus": {
                "enum": [
                  "exact",
                  "partial",
                  "miss"
                ]
              },
              "linkedIssueIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reviewerEvidence": {
                "type": "object",
                "required": [
                  "file",
                  "locator",
                  "quote"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "inFileResolution": {
                "enum": [
                  "L-resolved",
                  "L-open",
                  "L-unclosed",
                  "L-uncheckable"
                ]
              },
              "inFileEvidence": {
                "type": "object",
                "required": [
                  "file",
                  "locator"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string"
                  }
                }
              },
              "closureEvidence": {
                "type": "object",
                "required": [
                  "file",
                  "locator",
                  "quote"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "handling": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "bands": {
          "type": "object",
          "required": [
            "overlap",
            "aiOnly",
            "divergent",
            "reviewerOnly"
          ],
          "properties": {
            "overlap": {
              "type": "integer",
              "minimum": 0
            },
            "aiOnly": {
              "type": "integer",
              "minimum": 0
            },
            "divergent": {
              "type": "integer",
              "minimum": 0
            },
            "reviewerOnly": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "reviewerOnlyItems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "itemId",
              "title",
              "reviewerEvidence",
              "handling",
              "inFileResolution"
            ],
            "properties": {
              "itemId": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "reviewerEvidence": {
                "type": "object",
                "required": [
                  "file",
                  "locator",
                  "quote"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "description": "证据定位。材料侧：`<文件名>!<sheet>!<单元格或区域>`。非单元格证据（图片/页眉页脚/批注/形状/图表）另用受控写法：`<sheet>!图片#<序号>（锚点 <起始行>:<结束行>）`、`<sheet>!页眉`、`<sheet>!页脚`、`<sheet>!批注!<单元格>`、`<sheet>!图形#<序号>`、扫描件 `<文件名>#第<N>页`。该形态只能来自 raw 原件直读（工作版不含这些部件）；未核验的写「未核验」，严禁写「缺失/为空/未列示」。口径见 00-input-and-route-profile.md §Excel 与 11-html-delivery-spec.md §4.3。",
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "inFileResolution": {
                "enum": [
                  "L-resolved",
                  "L-open",
                  "L-unclosed",
                  "L-uncheckable"
                ]
              },
              "inFileEvidence": {
                "type": "object",
                "required": [
                  "file",
                  "locator"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "description": "证据定位。材料侧：`<文件名>!<sheet>!<单元格或区域>`。非单元格证据（图片/页眉页脚/批注/形状/图表）另用受控写法：`<sheet>!图片#<序号>（锚点 <起始行>:<结束行>）`、`<sheet>!页眉`、`<sheet>!页脚`、`<sheet>!批注!<单元格>`、`<sheet>!图形#<序号>`、扫描件 `<文件名>#第<N>页`。该形态只能来自 raw 原件直读（工作版不含这些部件）；未核验的写「未核验」，严禁写「缺失/为空/未列示」。口径见 00-input-and-route-profile.md §Excel 与 11-html-delivery-spec.md §4.3。",
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string"
                  }
                }
              },
              "closureEvidence": {
                "type": "object",
                "required": [
                  "file",
                  "locator"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "description": "证据定位。材料侧：`<文件名>!<sheet>!<单元格或区域>`。非单元格证据（图片/页眉页脚/批注/形状/图表）另用受控写法：`<sheet>!图片#<序号>（锚点 <起始行>:<结束行>）`、`<sheet>!页眉`、`<sheet>!页脚`、`<sheet>!批注!<单元格>`、`<sheet>!图形#<序号>`、扫描件 `<文件名>#第<N>页`。该形态只能来自 raw 原件直读（工作版不含这些部件）；未核验的写「未核验」，严禁写「缺失/为空/未列示」。口径见 00-input-and-route-profile.md §Excel 与 11-html-delivery-spec.md §4.3。",
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string"
                  }
                }
              },
              "handling": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "resolved": {
              "type": "integer",
              "minimum": 0
            },
            "uncheckable": {
              "type": "integer",
              "minimum": 0
            },
            "evaluable": {
              "type": "integer",
              "minimum": 0
            },
            "exactHits": {
              "type": "integer",
              "minimum": 0
            },
            "partialHits": {
              "type": "integer",
              "minimum": 0
            },
            "misses": {
              "type": "integer",
              "minimum": 0
            },
            "strictHitRate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "coverageRate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "aiHitRate": {
              "type": "string"
            },
            "denominator": {
              "type": "string",
              "minLength": 1
            },
            "denominatorExclResolved": {
              "type": "string"
            },
            "aiHitRateExclResolved": {
              "type": "string"
            }
          }
        }
      }
    },
    "externalDataVerification": {
      "type": "object",
      "description": "外部数据核验区（可选）：先按知识库表 A 判断适用性。not_applicable 时只说明原因与依据，不探测来源；required 时以报告基准日为锚，使用同花顺 iFinD 逐项核验，且仅在能力不可用时声明 unavailableDeclaration。",
      "required": [
        "applicability",
        "baseDate",
        "sources"
      ],
      "properties": {
        "applicability": {
          "type": "object",
          "description": "外部数据核验适用性前置判断。先按知识库 M-外部数据核验表 A 判断；仅 status=required 时才探测数据源并执行核验。",
          "required": [
            "status",
            "reason",
            "basis"
          ],
          "properties": {
            "status": {
              "enum": [
                "required",
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "type": "string",
              "minLength": 1,
              "description": "本次适用性判断引用的知识库路径与表/条款，例如 06-规则库/M-外部数据核验/01-模块-外部数据核验 · 表 A。"
            }
          }
        },
        "baseDate": {
          "type": "string",
          "minLength": 1
        },
        "unavailableDeclaration": {
          "type": "string",
          "description": "仅 applicability.status=required 且存在未配置/未认证数据源时填写（兜底声明由数据提供方写入，渲染器不自造句子）；not_applicable 时禁止填写。"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "configured",
              "authenticated",
              "note"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "configured": {
                "type": "boolean"
              },
              "authenticated": {
                "type": "boolean"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "checkId",
              "metric",
              "baseDate",
              "reportValue",
              "sources",
              "decision"
            ],
            "properties": {
              "checkId": {
                "type": "string",
                "minLength": 1
              },
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "baseDate": {
                "type": "string",
                "minLength": 1
              },
              "reportValue": {
                "type": "string",
                "minLength": 1
              },
              "deviationAgainst": {
                "type": "string",
                "description": "与本项目报告值出入较大的数据源名称（本环境即 同花顺 iFinD）；无差异时写 —"
              },
              "decision": {
                "enum": [
                  "符合",
                  "不符合",
                  "请说明",
                  "未检查"
                ]
              },
              "note": {
                "type": "string"
              },
              "reportEvidence": {
                "type": "object",
                "description": "判定为“不符合”时必须给出 locator",
                "properties": {
                  "fileId": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "locator": {
                    "description": "证据定位。材料侧：`<文件名>!<sheet>!<单元格或区域>`。非单元格证据（图片/页眉页脚/批注/形状/图表）另用受控写法：`<sheet>!图片#<序号>（锚点 <起始行>:<结束行>）`、`<sheet>!页眉`、`<sheet>!页脚`、`<sheet>!批注!<单元格>`、`<sheet>!图形#<序号>`、扫描件 `<文件名>#第<N>页`。该形态只能来自 raw 原件直读（工作版不含这些部件）；未核验的写「未核验」，严禁写「缺失/为空/未列示」。口径见 00-input-and-route-profile.md §Excel 与 11-html-delivery-spec.md §4.3。",
                    "type": "string"
                  }
                }
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "source",
                    "value"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "asOfDate": {
                      "type": "string"
                    },
                    "caliber": {
                      "type": "string",
                      "description": "取数口径（期限/窗口/频率/基准/复权等）"
                    },
                    "available": {
                      "type": "boolean",
                      "description": "该源未配置/未认证时必须为 false"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "inputs",
        "checkDomains",
        "notCheckedItems",
        "limitations"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "fileId",
              "displayName",
              "version",
              "readable"
            ],
            "properties": {
              "fileId": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "readable": {
                "type": "boolean"
              }
            }
          }
        },
        "checkDomains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "notCheckedItems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "itemId",
              "item",
              "reasonCode",
              "reason",
              "impact",
              "requiredAction",
              "relatedFiles"
            ],
            "properties": {
              "itemId": {
                "type": "string",
                "minLength": 1
              },
              "item": {
                "type": "string",
                "minLength": 1
              },
              "reasonCode": {
                "enum": [
                  "missing_material",
                  "unreadable",
                  "unsupported",
                  "out_of_scope",
                  "not_applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "requiredAction": {
                "type": "string",
                "minLength": 1
              },
              "relatedFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "professionalTrail": {
      "type": "object",
      "required": [
        "applicableRuleSnapshot",
        "adjudications",
        "checkRecords",
        "comprehensiveComparison"
      ],
      "properties": {
        "applicableRuleSnapshot": {
          "type": "object"
        },
        "adjudications": {
          "type": "array"
        },
        "checkRecords": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "recordId",
              "domain",
              "checkItem",
              "targets",
              "evidence",
              "result",
              "linkedIssueIds",
              "performedAt",
              "executor"
            ],
            "properties": {
              "recordId": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "checkItem": {
                "type": "string",
                "minLength": 1
              },
              "targets": {
                "type": "array"
              },
              "evidence": {
                "type": "array",
                "minItems": 1
              },
              "result": {
                "enum": [
                  "pass",
                  "difference",
                  "not_applicable",
                  "not_checked"
                ]
              },
              "linkedIssueIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "performedAt": {
                "type": "string",
                "minLength": 1
              },
              "executor": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "comprehensiveComparison": {
          "type": "object"
        }
      }
    },
    "fileTrace": {
      "type": "object",
      "required": [
        "generatedAt",
        "rendererVersion",
        "sourceDigest",
        "embeddedJsonDigest"
      ],
      "properties": {
        "generatedAt": {
          "type": "string",
          "minLength": 1
        },
        "rendererVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "embeddedJsonDigest": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        }
      }
    },
    "renderPolicy": {
      "type": "object",
      "required": [
        "printTrail",
        "language"
      ],
      "properties": {
        "printTrail": {
          "type": "boolean"
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aiScorecard": {
      "type": "object",
      "description": "AI 审核评分卡（自评；用于量化 AI 审核与人工复核的差距）。初审由 AI 自评，复审在初审基础上补充与校正（只增不覆盖）。",
      "required": [
        "level",
        "dimensions",
        "composites"
      ],
      "properties": {
        "level": {
          "enum": [
            "初审",
            "复审",
            "终审"
          ],
          "description": "审核级次，取值与台账 review_level 一致（初审/复审/终审）"
        },
        "dimensions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "score",
              "max",
              "basis"
            ],
            "properties": {
              "key": {
                "enum": [
                  "first_delivery_correctness",
                  "self_correction",
                  "incremental_value",
                  "coverage_completeness",
                  "process_discipline",
                  "judgment_quality"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "multipleOf": 0.5
              },
              "max": {
                "const": 10
              },
              "basis": {
                "type": "string",
                "minLength": 1,
                "description": "打分依据（必填，禁止无依据给分）"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "composites": {
          "type": "object",
          "required": [
            "aiOnly"
          ],
          "properties": {
            "aiOnly": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "multipleOf": 0.5,
              "description": "综合·AI 单机：六维均值按 0.5 取整"
            },
            "withHumanLoop": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "multipleOf": 0.5,
              "description": "综合·含人机复核闭环：复审校正后六维均值按 0.5 取整"
            }
          }
        },
        "corrections": {
          "type": "array",
          "description": "复审对初审分数的补充与校正（只增不覆盖，逐条给理由）",
          "items": {
            "type": "object",
            "required": [
              "key",
              "from",
              "to",
              "reason"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "multipleOf": 0.5
              },
              "to": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "multipleOf": 0.5
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "selfAuditErrors": {
      "type": "array",
      "description": "AI 审核错误项（AI 自身出错记录；初审即产出，复审追加人工指出/在件核验发现的错误）",
      "items": {
        "type": "object",
        "required": [
          "errorId",
          "kind",
          "discoveredAt",
          "description"
        ],
        "properties": {
          "errorId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "false_positive",
              "correction",
              "omission",
              "wording"
            ]
          },
          "discoveredAt": {
            "enum": [
              "初审",
              "复审",
              "终审"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correction": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "issueId": {
            "type": "string"
          }
        }
      }
    }
  }
}
